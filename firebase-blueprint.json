{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Store product listing in ZonixShop catalog",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "slug": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 5000 },
        "categoryId": { "type": "string", "maxLength": 128 },
        "categoryName": { "type": "string", "maxLength": 100 },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "stock": { "type": "number" },
        "sku": { "type": "string", "maxLength": 100 },
        "images": { "type": "array" },
        "status": { "type": "string", "enum": ["published", "draft", "archived"] },
        "featured": { "type": "boolean" },
        "rating": { "type": "number" },
        "reviewsCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "price", "stock", "sku", "status"]
    },
    "Category": {
      "title": "Category",
      "description": "Product category classification",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "slug": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 500 },
        "image": { "type": "string", "maxLength": 500 },
        "order": { "type": "number" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "slug", "active"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase order",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "orderNumber": { "type": "string", "maxLength": 50 },
        "customerId": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 120 },
        "customerEmail": { "type": "string", "maxLength": 120 },
        "customerPhone": { "type": "string", "maxLength": 30 },
        "shippingAddress": { "type": "object" },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "discount": { "type": "number" },
        "shippingFee": { "type": "number" },
        "total": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["cod", "bkash", "nagad"] },
        "paymentStatus": { "type": "string", "enum": ["unpaid", "pending_verification", "paid", "refunded"] },
        "orderStatus": { "type": "string", "enum": ["pending", "confirmed", "processing", "shipped", "delivered", "cancelled", "returned"] },
        "notes": { "type": "string", "maxLength": 1000 },
        "couponCode": { "type": "string", "maxLength": 50 },
        "trackingNumber": { "type": "string", "maxLength": 100 },
        "courierName": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "orderNumber", "customerId", "customerName", "customerPhone", "items", "total", "paymentMethod", "paymentStatus", "orderStatus"]
    },
    "User": {
      "title": "User",
      "description": "Customer or store member profile",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 120 },
        "displayName": { "type": "string", "maxLength": 120 },
        "phone": { "type": "string", "maxLength": 30 },
        "address": { "type": "string", "maxLength": 500 },
        "role": { "type": "string", "enum": ["customer", "admin"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email", "role"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Trusted administrative member",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 120 },
        "role": { "type": "string", "maxLength": 50 },
        "grantedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email", "role"]
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Discount coupon promotion",
      "type": "object",
      "properties": {
        "code": { "type": "string", "maxLength": 50 },
        "discountType": { "type": "string", "enum": ["percentage", "fixed"] },
        "discountValue": { "type": "number" },
        "minOrderValue": { "type": "number" },
        "maxDiscount": { "type": "number" },
        "validFrom": { "type": "string", "format": "date-time" },
        "validUntil": { "type": "string", "format": "date-time" },
        "usageLimit": { "type": "number" },
        "usedCount": { "type": "number" },
        "active": { "type": "boolean" }
      },
      "required": ["code", "discountType", "discountValue", "active"]
    },
    "StoreSettings": {
      "title": "StoreSettings",
      "description": "ZonixShop store operational settings",
      "type": "object",
      "properties": {
        "storeName": { "type": "string", "maxLength": 100 },
        "supportEmail": { "type": "string", "maxLength": 120 },
        "supportPhone": { "type": "string", "maxLength": 30 },
        "address": { "type": "string", "maxLength": 300 },
        "currency": { "type": "string", "maxLength": 10 },
        "currencySymbol": { "type": "string", "maxLength": 10 },
        "deliveryChargeInsideDhaka": { "type": "number" },
        "deliveryChargeOutsideDhaka": { "type": "number" },
        "freeShippingThreshold": { "type": "number" },
        "codEnabled": { "type": "boolean" },
        "bkashMerchantNumber": { "type": "string", "maxLength": 30 },
        "nagadMerchantNumber": { "type": "string", "maxLength": 30 },
        "bannerNotice": { "type": "string", "maxLength": 500 }
      },
      "required": ["storeName", "currency", "deliveryChargeInsideDhaka", "deliveryChargeOutsideDhaka", "codEnabled"]
    },
    "Banner": {
      "title": "Banner",
      "description": "Promotional homepage showcase banner",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 150 },
        "subtitle": { "type": "string", "maxLength": 300 },
        "link": { "type": "string", "maxLength": 300 },
        "imageUrl": { "type": "string", "maxLength": 600 },
        "active": { "type": "boolean" },
        "order": { "type": "number" }
      },
      "required": ["id", "title", "imageUrl", "active"]
    },
    "InventoryEvent": {
      "title": "InventoryEvent",
      "description": "Stock balance change log event",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "productId": { "type": "string", "maxLength": 128 },
        "changeType": { "type": "string", "enum": ["order_placed", "admin_restock", "admin_adjustment", "order_cancelled"] },
        "delta": { "type": "number" },
        "remainingStock": { "type": "number" },
        "orderId": { "type": "string", "maxLength": 128 },
        "notes": { "type": "string", "maxLength": 500 },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "productId", "changeType", "delta", "remainingStock"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Security and administrative audit trail",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "actorId": { "type": "string", "maxLength": 128 },
        "actorEmail": { "type": "string", "maxLength": 120 },
        "action": { "type": "string", "maxLength": 100 },
        "resource": { "type": "string", "maxLength": 100 },
        "resourceId": { "type": "string", "maxLength": 128 },
        "details": { "type": "object" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "actorId", "actorEmail", "action", "resource"]
    },
    "SupportTicket": {
      "title": "SupportTicket",
      "description": "Customer care and support inquiry ticket",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "customerId": { "type": "string", "maxLength": 128 },
        "customerEmail": { "type": "string", "maxLength": 120 },
        "customerName": { "type": "string", "maxLength": 120 },
        "subject": { "type": "string", "maxLength": 200 },
        "message": { "type": "string", "maxLength": 3000 },
        "status": { "type": "string", "enum": ["open", "in_progress", "resolved", "closed"] },
        "priority": { "type": "string", "enum": ["low", "normal", "high", "urgent"] },
        "replies": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "customerId", "customerEmail", "customerName", "subject", "message", "status"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": { "$ref": "Product" },
      "description": "Public catalog items and inventory tracking"
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "Category" },
      "description": "Product categories"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "Order" },
      "description": "Customer purchase orders"
    },
    "/users/{userId}": {
      "schema": { "$ref": "User" },
      "description": "User profiles and contact info"
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "Admin" },
      "description": "Trusted admin role registry"
    },
    "/coupons/{couponId}": {
      "schema": { "$ref": "Coupon" },
      "description": "Promotional discount codes"
    },
    "/storeSettings/{settingId}": {
      "schema": { "$ref": "StoreSettings" },
      "description": "Store operational configuration"
    },
    "/banners/{bannerId}": {
      "schema": { "$ref": "Banner" },
      "description": "Homepage promotional banners"
    },
    "/inventoryEvents/{eventId}": {
      "schema": { "$ref": "InventoryEvent" },
      "description": "Inventory change history events"
    },
    "/auditLogs/{logId}": {
      "schema": { "$ref": "AuditLog" },
      "description": "Administrative actions audit log"
    },
    "/supportTickets/{ticketId}": {
      "schema": { "$ref": "SupportTicket" },
      "description": "Customer support conversations"
    }
  }
}
